        // 比對使用者號碼與已載入開獎號碼，並回傳獎項等級
        private void btnCheck_Click(object sender, EventArgs e)
        {
            if (currentNumbers == null || currentNumbers.Length == 0)
            {
                MessageBox.Show("請先產生號碼。", "提醒", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            if (winningSets.Count == 0)
            {
                MessageBox.Show("尚未讀取任何開獎號碼檔案。", "提醒", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            bool anyWin = false;
            AppendResult($"開始比對：您號碼 {string.Join(", ", currentNumbers)}");

            // 對每一組開獎號碼進行比對
            txtResults.AppendText($"比對結果：您號碼 {string.Join(", ", currentNumbers)}" + Environment.NewLine);
            for (int i = 0; i < winningSets.Count; i++)
            {
                var win = winningSets[i];
                // 計算命中數量與命中號碼
                int hits = 0;
                var matched = new List<int>();
                for (int a = 0; a < currentNumbers.Length; a++)
                {
                    for (int b = 0; b < win.Length; b++)
                    {
                        if (currentNumbers[a] == win[b])
                        {
                            hits++;
                            matched.Add(currentNumbers[a]);
                            break;
                        }
                    }
                }

                if (hits > 0) anyWin = true;

                string prize = GetPrizeLevel(hits);
                AppendResult($"第 {i + 1} 組開獎號碼：{string.Join(", ", win)}");
                AppendResult($"命中數量：{hits}，命中號碼：{(matched.Count > 0 ? string.Join(", ", matched) : "無")}");
                AppendResult($"對應獎項：{prize}");
                AppendResult("-----------------------------");

                string lineResult = $"第 {i + 1} 組開獎：{string.Join(", ", win)} -> 中 {hits} 顆";
                AppendResult(lineResult);

                // 若為最後一組，於號碼顯示區高亮命中
                if (i == winningSets.Count - 1)
                {
                    HighlightMatchesAgainst(win);
                }
            }

            if (!anyWin)
            {
                AppendResult("未中獎。");
            }
            else
            {
                AppendResult("已至少命中 1 顆號碼。詳細請參閱上方紀錄。");
            }
        }

        private string GetPrizeLevel(int hits)
        {
            // 定義獎項等級：依命中數量給予對應等級
            // 5 -> 頭獎, 4 -> 特等, 3 -> 二等, 2 -> 三等, 1 -> 安慰獎, 0 -> 未中獎
            switch (hits)
            {
                case 5:
                    return "頭獎（全中 5 顆）";
                case 4:
                    return "特等獎（中 4 顆）";
                case 3:
                    return "二等獎（中 3 顆）";
                case 2:
                    return "三等獎（中 2 顆）";
                case 1:
                    return "安慰獎（中 1 顆）";
                default:
                    return "未中獎";
            }
        }

        private int[] GenerateUniqueNumbers(int count, int minInclusive, int maxInclusive)
        {
            // Basic array-based algorithm: avoid advanced collections and LINQ for generation
            int range = maxInclusive - minInclusive + 1;
            if (count > range)
            {
                throw new ArgumentException("count is greater than the available range");
            }

            int[] result = new int[count];
            bool[] used = new bool[range]; // index 0 corresponds to minInclusive
            int filled = 0;

            while (filled < count)
            {
                int val = rng.Next(range) + minInclusive; // random in [minInclusive, maxInclusive]
                int idx = val - minInclusive;
                if (!used[idx])
                {
                    used[idx] = true;
                    result[filled] = val;
                    filled++;
                }
                // otherwise repeat
            }

            // Simple bubble sort to order numbers (basic constructs only)
            for (int i = 0; i < count - 1; i++)
            {
                for (int j = 0; j < count - 1 - i; j++)
                {
                    if (result[j] > result[j + 1])
                    {
                        int tmp = result[j];
                        result[j] = result[j + 1];
                        result[j + 1] = tmp;
                    }
                }
            }

            return result;
        }

        private int[] ParseLineToNumbers(string line)
        {
            // 支援逗號或空白分隔，改為 4 個號碼
            var tokens = line.Split(new[] { ',', ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);
            if (tokens.Length != 4) return null;

            int[] nums = new int[4];
            for (int i = 0; i < 4; i++)
            {
                if (!int.TryParse(tokens[i], out int v)) return null;
                if (v < 1 || v > 49) return null;
                nums[i] = v;
            }

            if (nums.Distinct().Count() != 4) return null;
            Array.Sort(nums);
            return nums;
        }

