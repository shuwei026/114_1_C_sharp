        private void btnLoadWinning_Click(object sender, EventArgs e)
        {
            if (openFileDialog1.ShowDialog() != DialogResult.OK) return;
            string path = openFileDialog1.FileName;

            // Clear previous data
            winningSets.Clear();

            try
            {
                if (!File.Exists(path))
                {
                    AppendResult($"讀取失敗：檔案不存在 ({Path.GetFileName(path)})");
                    MessageBox.Show("指定的檔案不存在。", "檔案錯誤", MessageBoxButtons.OK, MessageBoxIcon.Error);
                    return;
                }

                var rawLines = File.ReadAllLines(path);
                // filter out empty lines but keep order
                var lines = rawLines.Select(l => l?.Trim()).Where(l => !string.IsNullOrEmpty(l)).ToList();

                // Expect exactly 5 non-empty lines
                if (lines.Count != 5)
                {
                    AppendResult($"檔案格式錯誤：預期 5 行有效數字，但讀到 {lines.Count} 行");
                    MessageBox.Show("檔案格式錯誤：請確認檔案有 5 行，每行一個數字。", "格式錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }

                var nums = new int[5];
                for (int i = 0; i < 5; i++)
                {
                    var s = lines[i];
                    if (!int.TryParse(s, out int v))
                    {
                        AppendResult($"第 {i + 1} 行格式錯誤：無法解析為數字 -> '{s}'");
                        MessageBox.Show($"第 {i + 1} 行格式錯誤：無法解析為數字。", "格式錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                        return;
                    }

                    // Validate range (1..49)
                    if (v < 1 || v > 49)
                    {
                        AppendResult($"第 {i + 1} 行數字超出範圍：{v}（允許範圍 1-49）");
                        MessageBox.Show($"第 {i + 1} 行數字超出允許範圍 (1-49)。", "數值錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                        return;
                    }

                    nums[i] = v;
                }

                // Check duplicates
                if (nums.Distinct().Count() != nums.Length)
                {
                    AppendResult("檔案格式錯誤：數字出現重複，請確認 5 個數字互不相同。");
                    MessageBox.Show("檔案內出現重複數字，請確認每行為不同的數字。", "格式錯誤", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }

                // Keep the file order for display
                winningSets.Add(nums);

                UpdateWinningInfoLabel();
                AppendResult($"已讀取開獎號碼（檔案: {Path.GetFileName(path)})：{string.Join(", ", nums)}");
            }
            catch (IOException ioEx)
            {
                AppendResult($"讀取檔案失敗：{ioEx.Message}");
                MessageBox.Show("讀取檔案時發生 IO 錯誤：" + ioEx.Message, "IO 錯誤", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            catch (UnauthorizedAccessException uaEx)
            {
                AppendResult($"讀取檔案失敗：存取被拒。{uaEx.Message}");
                MessageBox.Show("無法存取檔案：存取被拒。請確認權限。", "存取錯誤", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
            catch (Exception ex)
            {
                AppendResult($"讀取檔案失敗：{ex.Message}");
                MessageBox.Show("讀取檔案時發生錯誤：" + ex.Message, "錯誤", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

