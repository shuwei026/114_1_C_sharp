        private void HighlightMatchesAgainst(int[] winSet)
        {
            ClearNumberHighlights();
            if (winSet == null || winSet.Length == 0) return;

            var winSetHash = new HashSet<int>(winSet);
            for (int i = 0; i < currentNumbers.Length; i++)
            {
                if (winSetHash.Contains(currentNumbers[i]))
                {
                    numberLabels[i].BackColor = Color.LightGreen;
                }
                else
                {
                    numberLabels[i].BackColor = Color.WhiteSmoke;
                }
            }
        }

        private void ClearNumberHighlights()
        {
            foreach (var lbl in numberLabels)
            {
                lbl.BackColor = Color.WhiteSmoke;
            }
