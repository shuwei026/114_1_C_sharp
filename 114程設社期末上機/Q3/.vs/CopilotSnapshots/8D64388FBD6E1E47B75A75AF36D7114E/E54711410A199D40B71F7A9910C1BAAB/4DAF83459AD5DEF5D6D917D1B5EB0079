using System;
using System.Collections.Generic;
using System.Drawing;
using System.IO;
using System.Linq;
using System.Windows.Forms;

namespace Q3
{
    public partial class Form1 : Form
    {
        private readonly Label[] numberLabels;
        private readonly Random rng = new Random();
        private int[] currentNumbers = new int[0];
        private readonly List<int[]> winningSets = new List<int[]>();

        public Form1()
        {
            InitializeComponent();

            // 建立 4 個號碼顯示 Label，使用可讀字體
            numberLabels = new Label[4];
            for (int i = 0; i < numberLabels.Length; i++)
            {
                var lbl = new Label();
                lbl.AutoSize = false;
                lbl.Size = new Size(90, 48);
                lbl.Margin = new Padding(18, 6, 6, 6);
                lbl.TextAlign = ContentAlignment.MiddleCenter;
                lbl.BorderStyle = BorderStyle.FixedSingle;
                lbl.Font = new Font(this.Font.FontFamily, 18F, FontStyle.Bold);
                lbl.BackColor = Color.WhiteSmoke;
                lbl.Text = string.Empty;
                numberLabels[i] = lbl;
                flpNumbers.Controls.Add(lbl);
            }

            // 初始顯示提示文字
            AppendResult("程式啟動。按「產生號碼」或讀取開獎檔案。");
            UpdateWinningInfoLabel();
        }

        private void btnGenerate_Click(object sender, EventArgs e)
        {
            currentNumbers = GenerateUniqueNumbers(4, 1, 49);
            DisplayCurrentNumbers();
            AppendResult($"本期開獎號碼：");
            for (int i = 0; i < currentNumbers.Length; i++)
            {
                AppendResult($"第{i + 1}個號碼： {currentNumbers[i]}");
            }
            ClearNumberHighlights();
        }

        private void btnLoadWinning_Click(object sender, EventArgs e)
        {
            if (openFileDialog1.ShowDialog() != DialogResult.OK) return;
            string path = openFileDialog1.FileName;
            winningSets.Clear();

            try
            {
                var lines = File.ReadAllLines(path);
                int lineNo = 0;
                foreach (var raw in lines)
                {
                    lineNo++;
                    if (string.IsNullOrWhiteSpace(raw)) continue;
                    var parsed = ParseLineToNumbers(raw.Trim());
                    if (parsed == null)
                    {
                        AppendResult($"第 {lineNo} 行格式錯誤：{raw}");
                        continue;
                    }
                    winningSets.Add(parsed);
                }

                UpdateWinningInfoLabel();
                AppendResult($"已讀取 {winningSets.Count} 組開獎號碼（檔案: {Path.GetFileName(path)}）。");
            }
            catch (Exception ex)
            {
                MessageBox.Show("讀取檔案失敗：" + ex.Message, "錯誤", MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        private void btnExit_Click(object sender, EventArgs e)
        {
            this.Close();
        }

        // 保留比對功能（若你需要比對多組開獎號碼可以再使用）
        private void btnCheck_Click(object sender, EventArgs e)
        {
            if (currentNumbers == null || currentNumbers.Length == 0)
            {
                MessageBox.Show("請先產生號碼。", "提醒", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            if (winningSets.Count == 0)
            {
                MessageBox.Show("尚未讀取任何開獎號碼檔案。", "提醒", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            bool anyWin = false;
            AppendResult($"開始比對：您號碼 {string.Join(", ", currentNumbers)}");

            for (int i = 0; i < winningSets.Count; i++)
            {
                var win = winningSets[i];
                int hits = currentNumbers.Intersect(win).Count();
                if (hits > 0) anyWin = true;

                string lineResult = $"第 {i + 1} 組開獎：{string.Join(", ", win)} -> 中 {hits} 顆";
                AppendResult(lineResult);
            }

            HighlightMatchesAgainst(winningSets.Last());

            if (!anyWin)
            {
                AppendResult("未中獎。");
            }
            else
            {
                AppendResult("已至少命中 1 顆號碼。詳細請參閱上方紀錄。");
            }
        }

        private int[] GenerateUniqueNumbers(int count, int minInclusive, int maxInclusive)
        {
            var pool = Enumerable.Range(minInclusive, maxInclusive - minInclusive + 1).ToList();
            var result = new List<int>(count);
            for (int i = 0; i < count; i++)
            {
                int idx = rng.Next(pool.Count);
                result.Add(pool[idx]);
                pool.RemoveAt(idx);
            }
            result.Sort();
            return result.ToArray();
        }

        private int[] ParseLineToNumbers(string line)
        {
            // 支援逗號或空白分隔，改為 4 個號碼
            var tokens = line.Split(new[] { ',', ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries);
            if (tokens.Length != 4) return null;

            int[] nums = new int[4];
            for (int i = 0; i < 4; i++)
            {
                if (!int.TryParse(tokens[i], out int v)) return null;
                if (v < 1 || v > 49) return null;
                nums[i] = v;
            }

            if (nums.Distinct().Count() != 4) return null;
            Array.Sort(nums);
            return nums;
        }

        private void DisplayCurrentNumbers()
        {
            for (int i = 0; i < numberLabels.Length; i++)
            {
                numberLabels[i].Text = currentNumbers.Length > i ? currentNumbers[i].ToString() : string.Empty;
                numberLabels[i].BackColor = Color.WhiteSmoke;
            }
        }

        private void AppendResult(string text)
        {
            // 保留簡潔輸出（不加入時間戳，呈現與你畫面相近的內容）
            txtResults.AppendText($"{text}{Environment.NewLine}");
        }

        private void UpdateWinningInfoLabel()
        {
            // Designer 中未顯示此項，如需顯示可再加入 label
        }

        private void HighlightMatchesAgainst(int[] winSet)
        {
            ClearNumberHighlights();
            if (winSet == null || winSet.Length == 0) return;

            var winSetHash = new HashSet<int>(winSet);
            for (int i = 0; i < currentNumbers.Length; i++)
            {
                if (winSetHash.Contains(currentNumbers[i]))
                {
                    numberLabels[i].BackColor = Color.LightGreen;
                }
                else
                {
                    numberLabels[i].BackColor = Color.WhiteSmoke;
                }
            }
        }

        private void ClearNumberHighlights()
        {
            foreach (var lbl in numberLabels)
            {
                lbl.BackColor = Color.WhiteSmoke;
            }
        }
    }
}
