using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Globalization;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace Q2
{
    public partial class Form1 : Form
    {
        // constants for rates
        private const decimal HourlyRate = 600m; // 每小時費率 (NT$600)
        private const decimal PartsTaxRate = 0.06m; // 6% 稅率

        // estimated parts cost per service (NT$)
        private readonly Dictionary<CheckBox, decimal> _estimatedParts = new Dictionary<CheckBox, decimal>();
        // estimated labor hours per service
        private readonly Dictionary<CheckBox, decimal> _estimatedHours = new Dictionary<CheckBox, decimal>();

        public Form1()
        {
            InitializeComponent();
            // show hourly rate text
            labelHourlyRate.Text = $"每小時 NT${HourlyRate}";

            // initialize estimates (tweak values as needed)
            _estimatedParts[chkOilChange] = 120m;
            _estimatedHours[chkOilChange] = 0.5m;

            _estimatedParts[chkLubrication] = 50m;
            _estimatedHours[chkLubrication] = 0.5m;

            _estimatedParts[chkRadiator] = 0m;
            _estimatedHours[chkRadiator] = 1.0m;

            _estimatedParts[chkTransmission] = 500m; // parts estimate for transmission service
            _estimatedHours[chkTransmission] = 2.5m;

            _estimatedParts[chkInspection] = 0m;
            _estimatedHours[chkInspection] = 0.5m;

            _estimatedParts[chkReplaceMuffler] = 2000m;
            _estimatedHours[chkReplaceMuffler] = 2.0m;

            _estimatedParts[chkTireRotation] = 0m;
            _estimatedHours[chkTireRotation] = 0.5m;

            // initial calculation
            Recalculate(showMessages: false);
        }

        private void btnCalculate_Click(object sender, EventArgs e)
        {
            Recalculate(showMessages: true);
        }

        // realtime input changed handler
        private void InputChanged(object sender, EventArgs e)
        {
            Recalculate(showMessages: false);
        }

        private void Recalculate(bool showMessages)
        {
            try
            {
                decimal serviceSum = 0m;
                decimal partsSum = 0m;
                decimal hoursSum = 0m;

                // sum checked services using Tag and add estimated parts/hours
                var checks = new[] { chkOilChange, chkLubrication, chkRadiator, chkTransmission, chkInspection, chkReplaceMuffler, chkTireRotation };
                foreach (var c in checks)
                {
                    if (c.Checked)
                    {
                        if (c.Tag is decimal)
                            serviceSum += (decimal)c.Tag;

                        if (_estimatedParts.ContainsKey(c))
                            partsSum += _estimatedParts[c];

                        if (_estimatedHours.ContainsKey(c))
                            hoursSum += _estimatedHours[c];
                    }
                }

                // compute tax on parts 6%
                decimal tax = Math.Round(partsSum * PartsTaxRate, 2);

                // labor cost based on computed hours
                decimal labor = hoursSum * HourlyRate;

                decimal serviceAndLabor = serviceSum + labor; // 服務與工資總額
                decimal total = serviceAndLabor + partsSum + tax;

                // format for display
                var ci = CultureInfo.GetCultureInfo("zh-TW");
                txtServiceFee.Text = serviceSum.ToString("C2", ci);
                txtLabor.Text = labor.ToString("C2", ci);
                txtPartsCost.Text = partsSum.ToString("C2", ci);
                txtPartsTax.Text = tax.ToString("C2", ci);
                txtTotal.Text = total.ToString("C2", ci);

                // show computed parts and hours in the parts panel (read-only fields)
                txtParts.Text = partsSum.ToString("N2", CultureInfo.CurrentCulture);
                txtHours.Text = hoursSum.ToString("N2", CultureInfo.CurrentCulture);
            }
            catch (Exception ex)
            {
                if (showMessages)
                    MessageBox.Show("發生錯誤: " + ex.Message);
            }
        }

        private void btnClear_Click(object sender, EventArgs e)
        {
            // uncheck all
            chkOilChange.Checked = false;
            chkLubrication.Checked = false;
            chkRadiator.Checked = false;
            chkTransmission.Checked = false;
            chkInspection.Checked = false;
            chkReplaceMuffler.Checked = false;
            chkTireRotation.Checked = false;

            // reset computed fields
            txtParts.Text = string.Empty;
            txtHours.Text = string.Empty;

            txtServiceFee.Text = "";
            txtLabor.Text = "";
            txtPartsCost.Text = "";
            txtPartsTax.Text = "";
            txtTotal.Text = "";
        }

        private void btnExit_Click(object sender, EventArgs e)
        {
            this.Close();
        }

        private void Form1_Load(object sender, EventArgs e)
        {

        }
    }
}
