using System;
using System.Collections.Generic;
using System.ComponentModel;
using System.Data;
using System.Drawing;
using System.Globalization;
using System.IO;
using System.Linq;
using System.Text;
using System.Threading.Tasks;
using System.Windows.Forms;

namespace Q2
{
    public partial class Form1 : Form
    {
        // constants for rates
        public const decimal LABOR_RATE_PER_HOUR = 600m; // 每小時費率 (NT$600)
        private const decimal PartsTaxRate = 0.06m; // 6% 稅率

        // estimated parts cost per service (NT$)
        private readonly Dictionary<CheckBox, decimal> _estimatedParts = new Dictionary<CheckBox, decimal>();
        // estimated labor hours per service
        private readonly Dictionary<CheckBox, decimal> _estimatedHours = new Dictionary<CheckBox, decimal>();

        public Form1()
        {
            InitializeComponent();
            // show hourly rate text
            labelHourlyRate.Text = $"每小時 NT${LABOR_RATE_PER_HOUR}";

            // initialize estimates (tweak values as needed)
            _estimatedParts[chkOilChange] = 120m;
            _estimatedHours[chkOilChange] = 0.5m;

            _estimatedParts[chkLubrication] = 50m;
            _estimatedHours[chkLubrication] = 0.5m;

            _estimatedParts[chkRadiator] = 0m;
            _estimatedHours[chkRadiator] = 1.0m;

            _estimatedParts[chkTransmission] = 500m; // parts estimate for transmission service
            _estimatedHours[chkTransmission] = 2.5m;

            _estimatedParts[chkInspection] = 0m;
            _estimatedHours[chkInspection] = 0.5m;

            _estimatedParts[chkReplaceMuffler] = 2000m;
            _estimatedHours[chkReplaceMuffler] = 2.0m;

            _estimatedParts[chkTireRotation] = 0m;
            _estimatedHours[chkTireRotation] = 0.5m;

            // wire form closing to prompt for save
            this.FormClosing += Form1_FormClosing;

            // initial calculation
            Recalculate(showMessages: false);
        }

        private void btnCalculate_Click(object sender, EventArgs e)
        {
            Recalculate(showMessages: true);
        }

        // realtime input changed handler
        private void InputChanged(object sender, EventArgs e)
        {
            Recalculate(showMessages: false);
        }

        private void Recalculate(bool showMessages)
        {
            try
            {
                decimal serviceSum = 0m;
                decimal partsSum = 0m;
                decimal hoursSum = 0m;

                // sum checked services using Tag and add estimated parts/hours
                var checks = new[] { chkOilChange, chkLubrication, chkRadiator, chkTransmission, chkInspection, chkReplaceMuffler, chkTireRotation };
                foreach (var c in checks)
                {
                    if (c.Checked)
                    {
                        if (c.Tag is decimal)
                            serviceSum += (decimal)c.Tag;

                        if (_estimatedParts.ContainsKey(c))
                            partsSum += _estimatedParts[c];

                        if (_estimatedHours.ContainsKey(c))
                            hoursSum += _estimatedHours[c];
                    }
                }

                // compute tax on parts 6%
                decimal tax = Math.Round(partsSum * PartsTaxRate, 2);

                // labor cost based on computed hours
                decimal labor = hoursSum * LABOR_RATE_PER_HOUR;

                decimal serviceAndLabor = serviceSum + labor; // 服務與工資總額
                decimal total = serviceAndLabor + partsSum + tax;

                // format for display
                var ci = CultureInfo.GetCultureInfo("zh-TW");
                txtServiceFee.Text = serviceSum.ToString("C2", ci);
                txtLabor.Text = labor.ToString("C2", ci);
                txtPartsCost.Text = partsSum.ToString("C2", ci);
                txtPartsTax.Text = tax.ToString("C2", ci);
                txtTotal.Text = total.ToString("C2", ci);

                // show computed parts and hours in the parts panel (read-only fields)
                txtParts.Text = partsSum.ToString("N2", CultureInfo.CurrentCulture);
                txtHours.Text = hoursSum.ToString("N2", CultureInfo.CurrentCulture);
            }
            catch (Exception ex)
            {
                if (showMessages)
                    MessageBox.Show("發生錯誤: " + ex.Message);
            }
        }

        private void btnClear_Click(object sender, EventArgs e)
        {
            // uncheck all
            chkOilChange.Checked = false;
            chkLubrication.Checked = false;
            chkRadiator.Checked = false;
            chkTransmission.Checked = false;
            chkInspection.Checked = false;
            chkReplaceMuffler.Checked = false;
            chkTireRotation.Checked = false;

            // reset computed fields
            txtParts.Text = string.Empty;
            txtHours.Text = string.Empty;

            txtServiceFee.Text = "";
            txtLabor.Text = "";
            txtPartsCost.Text = "";
            txtPartsTax.Text = "";
            txtTotal.Text = "";
        }

        private void btnExit_Click(object sender, EventArgs e)
        {
            this.Close(); // triggers FormClosing where we'll prompt
        }

        private void Form1_Load(object sender, EventArgs e)
        {

        }

        private void Form1_FormClosing(object sender, FormClosingEventArgs e)
        {
            // If no data to save, allow close
            bool hasSelection = new[] { chkOilChange, chkLubrication, chkRadiator, chkTransmission, chkInspection, chkReplaceMuffler, chkTireRotation }
                .Any(c => c.Checked);

            bool hasValues = !string.IsNullOrWhiteSpace(txtTotal.Text) && txtTotal.Text != "NT$0.00" && txtTotal.Text != "";

            if (!hasSelection && !hasValues)
                return; // nothing to save

            var result = MessageBox.Show("結束前是否要儲存此次維修明細？", "儲存確認", MessageBoxButtons.YesNoCancel, MessageBoxIcon.Question);
            if (result == DialogResult.Yes)
            {
                // attempt save; if save canceled, cancel closing
                var saved = SaveReport();
                if (!saved)
                {
                    e.Cancel = true;
                }
            }
            else if (result == DialogResult.Cancel)
            {
                e.Cancel = true; // cancel exit
            }
            // No -> proceed to close
        }

        private bool SaveReport()
        {
            try
            {
                string report = BuildReportString();

                using (var sfd = new SaveFileDialog())
                {
                    sfd.Filter = "Text Files (*.txt)|*.txt|All Files (*.*)|*.*";
                    sfd.FileName = $"RepairReport_{DateTime.Now:yyyyMMdd_HHmmss}.txt";

                    if (sfd.ShowDialog() != DialogResult.OK)
                        return false; // user cancelled

                    File.WriteAllText(sfd.FileName, report, Encoding.UTF8);

                    MessageBox.Show($"已儲存檔案: {sfd.FileName}", "儲存完成", MessageBoxButtons.OK, MessageBoxIcon.Information);
                    return true;
                }
            }
            catch (Exception ex)
            {
                MessageBox.Show("儲存失敗: " + ex.Message, "錯誤", MessageBoxButtons.OK, MessageBoxIcon.Error);
                return false;
            }
        }

        private string BuildReportString()
        {
            var sb = new StringBuilder();
            var ci = CultureInfo.GetCultureInfo("zh-TW");

            sb.AppendLine("=== 汽車維修服務明細報表 ===");
            sb.AppendLine($"列印時間: {DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss")}");
            sb.AppendLine(new string('-', 60));

            sb.AppendLine("項目清單:");
            // list services
            var serviceItems = new[] { chkOilChange, chkLubrication, chkRadiator, chkTransmission, chkInspection, chkReplaceMuffler, chkTireRotation };
            decimal serviceSum = 0m;
            decimal partsSum = 0m;
            decimal hoursSum = 0m;

            foreach (var c in serviceItems)
            {
                bool selected = c.Checked;
                decimal price = c.Tag is decimal ? (decimal)c.Tag : 0m;
                decimal estParts = _estimatedParts.ContainsKey(c) ? _estimatedParts[c] : 0m;
                decimal estHours = _estimatedHours.ContainsKey(c) ? _estimatedHours[c] : 0m;

                sb.AppendLine($"- {c.Text}  | 選取: {(selected ? "是" : "否")}  | 價格: {price.ToString("C0", ci)}  | 估計零件: {estParts.ToString("C0", ci)}  | 估計工時: {estHours} 小時");

                if (selected)
                {
                    serviceSum += price;
                    partsSum += estParts;
                    hoursSum += estHours;
                }
            }

            sb.AppendLine(new string('-', 60));

            decimal tax = Math.Round(partsSum * PartsTaxRate, 2);
            decimal labor = hoursSum * LABOR_RATE_PER_HOUR;
            decimal serviceAndLabor = serviceSum + labor;
            decimal total = serviceAndLabor + partsSum + tax;

            sb.AppendLine("計算明細:");
            sb.AppendLine($"服務費合計: {serviceSum.ToString("C2", ci)}");
            sb.AppendLine($"估計零件費: {partsSum.ToString("C2", ci)}");
            sb.AppendLine($"零件稅 ({PartsTaxRate * 100}%): {tax.ToString("C2", ci)}");
            sb.AppendLine($"估計工時 (總小時): {hoursSum.ToString("N2", ci)} 小時");
            sb.AppendLine($"工時費率: {LABOR_RATE_PER_HOUR.ToString("C0", ci)} / 小時");
            sb.AppendLine($"工資合計: {labor.ToString("C2", ci)}");
            sb.AppendLine($"服務與工資總額: {serviceAndLabor.ToString("C2", ci)}");
            sb.AppendLine($"最終總費用: {total.ToString("C2", ci)}");

            sb.AppendLine(new string('-', 60));
            sb.AppendLine("感謝您的使用，歡迎下次光臨。");

            return sb.ToString();
        }
    }
}
